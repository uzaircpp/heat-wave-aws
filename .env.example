# Copy to .env and fill in. Everything except OFFICER_TOKEN and CONTACT_EMAIL is optional.

# Long random string. Ward officers paste it once in the app to assign reports and send alerts.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
OFFICER_TOKEN=

# Your email. OpenStreetMap services (Nominatim, Overpass) require a contact in the User-Agent.
CONTACT_EMAIL=

# Database. SQLite works for a pilot; use Postgres when you deploy for real.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/urbanshield
DATABASE_URL=

# SMS and WhatsApp alerts through Twilio (optional). Without these, alerts go to the app only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=

# Only if you buy Open-Meteo's commercial plan (needed for commercial use of the API).
OPEN_METEO_API_KEY=

# Allowed browser origins for the API, comma separated. * is fine while testing.
CORS_ORIGINS=*

# Tuning (defaults are sensible)
# WEATHER_REFRESH_S=900
# ALERTS_REFRESH_S=600
# WEATHER_GRID=6
# UHI_MAX_C=1.5
# DRAIN_CAPACITY_MMH=25
# FLOOD_PONDING=8

# Push alerts (Web Push). A key pair is created and stored in the database on first use;
# set this only to pin a key (PEM, \n for new lines). Check interval in seconds.
# VAPID_PRIVATE_KEY=
# PUSH_CHECK_S=300
# AWS voice for the assistant: add "polly" to APP_FEATURES (POLLY_REGION defaults to APP_AWS_REGION)
